# Nginx configuration example for phaderkampit
# Save this as /etc/nginx/sites-available/phaderkampit

server {
    listen 80;
    server_name your-domain.com;  # Replace with your domain

    # Maximum upload size (for audio files)
    client_max_body_size 100M;

    # Static files (if serving directly through nginx)
    location /static/ {
        alias /path/to/your/static/files/;  # Update this path
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Uploaded files (if serving directly through nginx)
    location /uploads/ {
        alias /path/to/your/uploads/;  # Update this path
        expires 1d;
        add_header Cache-Control "public";
    }

    # Main application - proxy to Unix socket
    location / {
        proxy_pass http://unix:/tmp/phaderkampit.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts for audio processing
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

